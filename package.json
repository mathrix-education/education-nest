{
  "name": "@mathrix-education/education-nest",
  "version": "0.1.0",
  "description": "The Mathrix Education GraphQL API. Based on NestJS.",
  "keywords": [
    "mathrix",
    "education",
    "graphql",
    "api"
  ],
  "homepage": "https://github.com/mathrix-education/education-nest",
  "bugs": "https://github.com/mathrix-education/education-nest/issues",
  "license": "MIT",
  "maintainers": [
    {
      "name": "Mathieu Bour",
      "email": "mathieu@mathrix.fr",
      "url": "https://github.com/mathieu-bour"
    },
    {
      "name": "Valentin Pollart",
      "email": "valentin@mathrix.fr",
      "url": "https://github.com/valentinpollart"
    }
  ],
  "browser": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/mathrix-education/education-nest.git"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "tslint -p tsconfig.json -c tslint.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js"
  },
  "dependencies": {
    "@nestjs/common": "^6.7.2",
    "@nestjs/core": "^6.7.2",
    "@nestjs/graphql": "^6.5.3",
    "@nestjs/jwt": "^6.1.1",
    "@nestjs/passport": "^6.1.0",
    "@nestjs/platform-express": "^6.7.2",
    "@nestjs/typeorm": "^6.2.0",
    "apollo-server-express": "^2.9.6",
    "bcrypt": "^3.0.6",
    "compression": "^1.7.4",
    "graphql": "^14.5.8",
    "graphql-tools": "^4.0.5",
    "graphql-type-json": "^0.3.0",
    "mysql": "^2.17.1",
    "passport": "^0.4.0",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.0",
    "rxjs": "^6.5.3",
    "stripe": "^7.10.0",
    "type-graphql": "^0.17.5",
    "typeorm": "^0.2.20",
    "uuidv4": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^6.9.0",
    "@nestjs/schematics": "^6.7.0",
    "@nestjs/testing": "^6.7.1",
    "@types/bcrypt": "^3.0.0",
    "@types/express": "^4.17.1",
    "@types/jest": "^24.0.18",
    "@types/node": "^12.7.5",
    "@types/passport-jwt": "^3.0.2",
    "@types/passport-local": "^1.0.33",
    "@types/stripe": "^7.10.3",
    "@types/supertest": "^2.0.8",
    "jest": "^24.9.0",
    "prettier": "^1.18.2",
    "supertest": "^4.0.2",
    "ts-jest": "^24.1.0",
    "ts-loader": "^6.1.1",
    "ts-node": "^8.4.1",
    "tsconfig-paths": "^3.9.0",
    "tslint": "^5.20.0",
    "typescript": "^3.6.3"
  },
  "private": true,
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
